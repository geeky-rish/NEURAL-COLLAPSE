# ─────────────────────────────────────────────────────────────────────────────
# NC-MedAI — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Dataset Paths ─────────────────────────────────────────────────────────────
# Absolute or relative paths to your downloaded dataset directories.

HAM10000_CSV=./data/raw/HAM10000/HAM10000_metadata.csv
HAM10000_IMG_DIR=./data/raw/HAM10000/images

CHESTXRAY_ROOT=./data/raw/chest_xray

RETINAL_OCT_ROOT=./data/raw/OCT2017

# ── Experiment Settings ───────────────────────────────────────────────────────
RESULTS_DIR=./results
CHECKPOINT_DIR=./checkpoints
LOG_DIR=./logs

# ── Optional: Weights & Biases (if you switch from TensorBoard) ───────────────
# WANDB_API_KEY=your_wandb_api_key_here
# WANDB_PROJECT=nc-medai
# WANDB_ENTITY=your_username
