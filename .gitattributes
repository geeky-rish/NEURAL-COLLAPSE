# Auto-detect and normalise line endings to LF on all platforms
* text=auto eol=lf

# Force these to always be LF
*.py    text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
*.sh    text eol=lf
*.json  text eol=lf
*.cfg   text eol=lf
*.toml  text eol=lf

# Binary files — never touch line endings
*.pt    binary
*.pth   binary
*.pkl   binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.pdf   binary
*.zip   binary
*.gz    binary
